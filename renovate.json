{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranches": ["dev"],
  "schedule": ["before 6am on monday"],
  "semanticCommits": "enabled",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "labels": ["security"],
    "automerge": false
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "dev-dependencies",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["major"],
      "groupName": "dev-dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "description": "Runtime dependencies (server.js/lib/) ship in the add-on itself — always human-reviewed, never automerged, per this repo's regression policy.",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "description": "github/codeql-action ships init/analyze/upload-sarif as one versioned unit; a single-action bump leaves the others behind and breaks the Analyze job (#778). Grouping all github-actions updates together avoids that and cuts PR noise. CI-only, safe to automerge on green."
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": "github-actions"
    }
  ]
}
