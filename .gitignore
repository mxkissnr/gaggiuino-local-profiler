gaggiuino-local-profiler/node_modules/
gaggiuino-local-profiler/public/
gaggiuino-local-profiler/coverage/
gaggiuino-local-profiler/go/**/*_templ.go

# Phase 1 (#901): the Vite SPA bundle internal/webapp embeds is a build
# artifact staged by `make -C go frontend` / the Dockerfile's frontend
# stage. Only the committed dist/index.html placeholder is tracked, so a
# bare `go build ./...` resolves the embed with no npm step.
gaggiuino-local-profiler/go/internal/webapp/dist/*
!gaggiuino-local-profiler/go/internal/webapp/dist/index.html

# local runtime/verification artifacts — never committed, may contain live tokens
**/data_verify_tmp/
*.db
*.db-wal
*.db-shm
api_token.txt
preheat_state.json

# defence-in-depth: secrets that must never land in git regardless of location
.env
.env.*
*.pem
*.key
id_rsa
id_rsa.*

.memsearch/
graphify-out/
.claude/settings.local.json
**/.claude/skills/
**/.agents/
**/skills-lock.json
__pycache__/
*.pyc
